# Code Radar Backend Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/code_radar

# JWT / Security
JWT_SECRET=replace-with-strong-random-secret
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=code-radar
JWT_AUDIENCE=code-radar-api

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated CORS origins (strict in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=

# Disable CORS test endpoint in production
ENABLE_CORS_TEST_ENDPOINT=true
REFRESH_COOKIE_NAME=code_radar_refresh_token
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
USE_SECURE_COOKIES=false

# Health check behavior
HEALTHCHECK_INCLUDE_REDIS=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth / App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=

# Email Service (EmailJS)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Rate limit tuning
RATE_LIMIT_SCAN_PER_HOUR=10
RATE_LIMIT_UPLOAD_PER_HOUR=5
RATE_LIMIT_GENERAL_PER_MINUTE=100
RATE_LIMIT_UNAUTH_PER_MINUTE=20
